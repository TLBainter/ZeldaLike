; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ZeldaLikeProject"
run/main_scene="uid://jqso51haqh2i"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://bg6v5msmxacxc"

[autoload]

audioManager="*uid://cct1tqjxxcrx8"
dialogueDB="*uid://cbcxd8qo46pai"
debugConsole="*uid://l8t30uovjgbg"
textResolver="*uid://bqwsqn6f06yrk"
containerManager="*res://Scripts/Managers/manager_Container.gd"
SceneTransitionManager="*res://Scripts/Managers/manager_SceneTransition.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor]

script/templates_search_path="res://Scripts/_script_templates"

[editor_plugins]

enabled=PackedStringArray("res://addons/Todo_Manager/plugin.cfg")

[file_customization]

folder_colors={
"res://Scenes/": "blue",
"res://Scenes/Characters/Player/": "green",
"res://Scripts/": "gray",
"res://Scripts/Classes/Camera Class/Player Camera/": "green",
"res://Scripts/Classes/Entity Class/Characters/Player/": "green",
"res://Scripts/Classes/Entity Class/Component Class/Player Components/": "green",
"res://Scripts/Resources/Resource Files/Resources_Sound Libraries/Player Sound Libraries/": "green",
"res://Scripts/_script_templates/": "red",
"res://Sound/": "purple",
"res://Sound/SFX/Player/": "green",
"res://Sprites/": "orange",
"res://Sprites/Character Sprites/Player Sprites/": "green",
"res://Sprites/Debug Stuff/": "orange",
"res://Sprites/UX/InGameUX/PlayerStats/": "green",
"res://TileMaps/": "yellow",
"res://addons/": "gray"
}

