//Task for launching an auto-copy debug window when the debug game window is launched.
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Godot: Debug with Clipboard",
            "type": "shell",
            "command": "Start-Process",
            "args": [
                "powershell",
                "-ArgumentList",
                "'-ExecutionPolicy Bypass -Command . ''\"${workspaceFolder}\\debug_launch.ps1\"'' ''\"${workspaceFolder}\"'''"
            ],
            "problemMatcher": [],
            "group": "test"
        }
    ]
}